#!/usr/bin/python3
"""Serve a dossier tree on this machine's .local name, for a phone on the same wifi.

    ./serve [--root DIR] [--port 8788]

Enumerates DIR/<dossier>/<fragment>.md on EVERY request -- add a file, pull to
refresh on the phone, it is there. Nothing is built and nothing is cached.

Read-only by construction: it serves GET, it never writes, and it refuses any
path that escapes the root.
"""
import argparse, json, os, posixpath, socket, subprocess, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))

def local_name():
    try:
        n = subprocess.run(["scutil", "--get", "LocalHostName"],
                           capture_output=True, text=True, timeout=3).stdout.strip()
        if n: return n + ".local"
    except Exception: pass
    return socket.gethostname()

def lan_ip():
    for dev in ("en0", "en1", "en2"):
        try:
            ip = subprocess.run(["ipconfig", "getifaddr", dev],
                                capture_output=True, text=True, timeout=3).stdout.strip()
            if ip: return ip
        except Exception: pass
    return None

def index(root):
    """The whole catalogue. Fragment names are whatever is on disk -- nothing validates them."""
    out = []
    if not os.path.isdir(root): return out
    for name in sorted(os.listdir(root)):
        d = os.path.join(root, name)
        if not os.path.isdir(d) or name.startswith("."): continue
        frags, node = [], None
        for f in sorted(os.listdir(d)):
            p = os.path.join(d, f)
            if not os.path.isfile(p) or f.startswith("."): continue
            if f == "_node.json":
                try: node = json.load(open(p))
                except Exception: node = {"error": "unreadable _node.json"}
                continue
            stem, ext = os.path.splitext(f)
            frags.append({"n": stem, "ext": ext.lstrip("."), "bytes": os.path.getsize(p),
                          "mtime": int(os.path.getmtime(p))})
        out.append({"id": name, "fragments": frags, "node": node or {},
                    "state": "standalone" if os.path.isdir(os.path.join(d, ".git")) else "scratch"})
    return out

class H(BaseHTTPRequestHandler):
    server_version = "dossier-serve"
    def log_message(self, fmt, *a):
        sys.stderr.write("  %s %s\n" % (self.address_string(), fmt % a))

    def send(self, code, body, ctype):
        if isinstance(body, str): body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def safe(self, base, rel):
        """Refuse anything that leaves base. Absolute, symlink-resolved, prefix-checked."""
        p = os.path.realpath(os.path.join(base, rel.lstrip("/")))
        return p if p == base or p.startswith(base + os.sep) else None

    def do_GET(self):
        path = posixpath.normpath(self.path.split("?")[0])
        root = os.path.realpath(self.server.dossier_root)

        if path in ("/", "/index.html"):
            return self.send(200, open(os.path.join(HERE, "index.html"), "rb").read(),
                             "text/html; charset=utf-8")
        if path == "/index.json":
            return self.send(200, json.dumps({"root": os.path.basename(root),
                                              "dossiers": index(root)}, indent=1),
                             "application/json; charset=utf-8")
        if path.startswith("/d/"):
            p = self.safe(root, path[3:])
            if not p or not os.path.isfile(p):
                return self.send(404, "no such fragment\n", "text/plain; charset=utf-8")
            ctype = ("text/markdown; charset=utf-8" if p.endswith(".md")
                     else "application/octet-stream")
            return self.send(200, open(p, "rb").read(), ctype)
        self.send(404, "not found\n", "text/plain; charset=utf-8")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=os.path.join(HERE, "sample"))
    ap.add_argument("--port", type=int, default=8788)
    a = ap.parse_args()

    srv = ThreadingHTTPServer(("0.0.0.0", a.port), H)
    srv.dossier_root = a.root
    n, ip = local_name(), lan_ip()
    print("serving %s (%d dossiers)" % (a.root, len(index(a.root))))
    print("  on this mac   http://localhost:%d/" % a.port)
    print("  on your phone http://%s:%d/" % (n, a.port))
    if ip: print("                http://%s:%d/   (if .local is slow to resolve)" % (ip, a.port))
    print("ctrl-c to stop. read-only: it serves GET and never writes.")
    try: srv.serve_forever()
    except KeyboardInterrupt: print("\nstopped")

if __name__ == "__main__":
    main()
